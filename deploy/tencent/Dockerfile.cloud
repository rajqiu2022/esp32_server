FROM python:3.10-slim
WORKDIR /app
ARG DEBIAN_MIRROR=https://mirrors.cloud.tencent.com
ARG PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 install -y --no-install-recommends ffmpeg libopus0 libsndfile1 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-cloud.txt /tmp/
RUN pip install --timeout 30 --retries 2 --no-cache-dir -r /tmp/requirements-cloud.txt
COPY server/ server/
COPY scripts/ scripts/
COPY web/ web/
COPY vendor/xiaozhi/main/xiaozhi-server/ vendor/xiaozhi/main/xiaozhi-server/
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 ESP_BIND_HOST=0.0.0.0 ESP_DATA_DIR=/app/data ESP_ASR_BACKEND=sherpa
EXPOSE 8000 8002
CMD ["python", "scripts/run_all.py"]
